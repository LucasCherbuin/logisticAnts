FROM node:20-alpine

# Install Angular CLI globally
RUN npm install -g @angular/cli

# Set working directory matching the project structure
WORKDIR /logisticants/angular

# Copy dependency files first for better layer caching
COPY angular/package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the Angular project
COPY angular/ ./

EXPOSE 4200

CMD ["sh", "-c", "npm install && ng serve --host 0.0.0.0 --port 4200 --poll 2000  --no-hmr"]

